{
  "name": "fidelify-backoffice",
  "compatibility_date": "2026-10-29",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only /api goes through the Worker; everything else is served as a file.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "API_ORIGIN": "https://fidelify-backend-production.up.railway.app"
  }
}
